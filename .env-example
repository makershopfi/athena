# Copy this file to .env (same folder as docker-compose.yml) and fill in the values below.
# docker compose auto-loads a .env file next to it - nothing else needed to wire this up.

DB_NAME=athena
DB_USER=athena
DB_PASSWORD=secret_passwd
DB_ROOT_PASSWORD=very_secret_passwd

# Bundled MariaDB's own InnoDB buffer pool size (docker-compose.yml passes this straight through
# as --innodb-buffer-pool-size) - 512M by default, well above the mariadb image's own stock
# 128MB, since history tables keep growing for as long as history retention allows (up to 730
# days) and a too-small buffer pool means routine entity-history queries fall back to real disk
# I/O instead of serving from cache. Lower this on a genuinely RAM-constrained host (accepts M/G
# suffixes, e.g. 256M); raise it if your own install/retention window is much larger than typical.
DB_INNODB_BUFFER_POOL_SIZE=512M

# Host port to publish the app on.
ATHENA_PORT=8098

# phpMyAdmin port
PHPMYADMIN_PORT=6066

# Caddy port
CADDY_PORT=8098

# Image tag to run - set this to a specific version once you're deploying releases rather than
# whatever ./build-docker.sh <tag> most recently produced locally.
TAG=latest

# true runs Athena with no web UI at all - only /api/* stays reachable. For installs driven
# purely through the API (another automation system, a mobile app, a headless SBC with no
# reason to serve a browser UI).
ATHENA_HEADLESS=false

# Set this true once the bundled caddy service (see docker-compose.yml and Caddyfile) or any
# other reverse proxy is terminating HTTPS in front of Athena - needed for WebUSB/WebSerial
# device-flashing features, which browsers only allow over https://. Leave it false if you're
# accessing Athena directly over plain HTTP, since the session cookie's Secure flag would
# otherwise block login entirely.
ATHENA_SECURE_COOKIES=true


# Port the bundled caddy service (see Caddyfile) binds HTTPS to. Defaults to 8443 rather than
# the standard 443, since caddy runs with host networking and 443 is commonly already taken by
# another service on the same host. WebUSB/WebSerial only require the https:// scheme to treat
# the page as a secure context - they don't care which port it's on - so any free port works;
# just remember to include it when browsing (https://your-server:8443).
HTTPS_PORT=8088

# Only used by docker-compose.yml (the split deploy's Athena side) - point this at your other
# machine's own docker-compose-esphome.yml, e.g. http://192.168.1.50:6052. Leave blank to disable
# Compile/Validate entirely (device editing and the file manager still work either way).
# Ignored by docker-compose-with-esphome.yml, which already has its own bundled sidecar.
ESPHOME_DASHBOARD_URL=http://192.168.0.110:6052

# Credentials for the ESPHome dashboard - required if it's the split deploy's remote one
# (docker-compose-esphome.yml mandates auth, since its dashboard is published on the network);
# optional defense-in-depth if it's docker-compose-with-esphome.yml's own bundled sidecar
# (unreachable from outside the compose network either way). Leave both blank to disable.
ESPHOME_DASHBOARD_USERNAME=esphome
ESPHOME_DASHBOARD_PASSWORD=esphome

# MQTT broker for auto-discovery (Tasmota, Zigbee2MQTT, ESPHome's own native mqtt component, ...
# - anything speaking Home Assistant's own MQTT discovery convention). Both compose files bundle
# a Mosquitto broker and default this to it; point it elsewhere if you already run your own, or
# leave blank to disable MQTT auto-discovery entirely.
MQTT_BROKER_URL=tcp://127.0.0.1:1883

# Credentials for the MQTT broker - blank works with the bundled Mosquitto's own default config
# (anonymous access allowed, see mosquitto.conf). Set these if it requires auth (an
# external/existing broker, or the bundled one with anonymous access turned off).
MQTT_USERNAME=
MQTT_PASSWORD=

# Topic prefix discovery configs are published under - "homeassistant" is what every common
# publisher defaults to and rarely changes, but is itself configurable on all of them, so it's
# configurable here too.
MQTT_DISCOVERY_PREFIX=homeassistant

# "Forgot password" on the login page - this self-hosted instance has no SMTP of its own, so it
# asks the Athena website to relay the actual email instead (see docroot/api/relay-reset-email.php
# in that repo). Leave blank to disable "Forgot password" entirely - the link still shows, but
# tells the user to ask their administrator instead of a false promise.
PASSWORD_RESET_RELAY_URL=

# Must match whatever the relay endpoint's own RELAY_SHARED_SECRET is configured to (see that
# repo's app/config.local.php) - sent as Authorization: Bearer. The relay rejects every request
# outright if this doesn't match, so a request with this blank/wrong just fails - it never quietly
# lets the reset email through unauthenticated.
PASSWORD_RESET_RELAY_SECRET=
