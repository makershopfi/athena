# Copy to .env in this same folder, then:
#   docker compose -f docker-compose-deconz.yml up -d
# (a separate .env from docker-compose-athena.yml's own, if you run both in this same folder -
# pass --env-file explicitly, e.g. `docker compose -f docker-compose-deconz.yml --env-file
# .env.deconz up -d`, otherwise.)

# Absolute path to your ConBee/RaspBee stick's own stable device symlink - `ls /dev/serial/by-id/`
# to find it. Don't use /dev/ttyACM0 directly - that plain enumeration-order path can shift across
# reboots if more than one USB-serial adapter is plugged into the host.
DECONZ_STICK_DEVICE=/dev/serial/by-id/usb-dresden_elektronik_ConBee_II_...-if00

# deCONZ's own web UI (Phoscon) + REST API.
DECONZ_WEB_PORT=8080

# The WebSocket API Athena's own live-update connection uses - this is the port Athena's own
# "Add gateway" form needs.
DECONZ_WS_PORT=8443
