# Copy this file to .env (same folder as docker-compose-athena.yml), then:
#   docker compose -f docker-compose-athena.yml up -d
# docker compose auto-loads a .env file next to it - nothing else needed to wire this up.
#
# DB_*/PORT/HTTPS_PORT/ESPHOME_DASHBOARD_*/MQTT_*/PASSWORD_RESET_RELAY_* below are first-boot
# bootstrap values only - once Athena is running, its own Environment page (Database/Ports/ESPHome
# Dashboard/Password Reset cards) and the MQTT page's own Settings menu item let you change them
# without touching this file or a container restart (everything except database/ports applies
# immediately; those two still need a restart, but from the stored value, not this one). A value
# saved through the UI always wins over what's here from then on; deleting it there falls straight
# back to whatever's in this file.

DB_NAME=athena
DB_USER=athena
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Bundled MariaDB's own InnoDB buffer pool size (docker-compose-athena.yml passes this straight
# through as --innodb-buffer-pool-size) - 512M by default, well above the mariadb image's own
# stock 128MB, since history tables keep growing for as long as history retention allows (up to
# 730 days) and a too-small buffer pool means routine entity-history queries fall back to real
# disk I/O instead of serving from cache. Lower this on a genuinely RAM-constrained host (accepts
# M/G suffixes, e.g. 256M); raise it if your own install/retention window is much larger than
# typical.
DB_INNODB_BUFFER_POOL_SIZE=512M

# Host port to publish the app on (athena runs with host networking, so this is a direct bind, not
# a "host:container" port mapping).
ATHENA_PORT=8098

# phpMyAdmin's own port - LAN-trusted access only, same as MariaDB's own published port.
PHPMYADMIN_PORT=6066

# Port the bundled caddy service (see Caddyfile) publishes its own PORT env var as - matches
# ATHENA_PORT above since caddy reverse-proxies straight to it over 127.0.0.1.
CADDY_PORT=8098

# Image tag to run - set this to a specific version once you're deploying releases rather than
# whatever ./build-docker.sh <tag> most recently produced locally.
TAG=latest

# true runs Athena with no web UI at all - only /api/* stays reachable. For installs driven
# purely through the API (another automation system, a mobile app, a headless SBC with no
# reason to serve a browser UI).
ATHENA_HEADLESS=false

# Set this true once the bundled caddy service (see docker-compose-athena.yml and Caddyfile) or
# any other reverse proxy is terminating HTTPS in front of Athena - needed for WebUSB/WebSerial
# device-flashing features, which browsers only allow over https://. Leave it false if you're
# accessing Athena directly over plain HTTP, since the session cookie's Secure flag would
# otherwise block login entirely.
ATHENA_SECURE_COOKIES=true

# Port the bundled caddy service (see Caddyfile) binds HTTPS to. Defaults to 8443 rather than
# the standard 443, since caddy runs with host networking and 443 is commonly already taken by
# another service on the same host. WebUSB/WebSerial only require the https:// scheme to treat
# the page as a secure context - they don't care which port it's on - so any free port works;
# just remember to include it when browsing (https://your-server:8443).
HTTPS_PORT=8443

# Only used by docker-compose-athena.yml (the split deploy's Athena side) - point this at your
# other machine's own docker-compose-esphome.yml, e.g. http://192.168.1.50:6052. Leave blank to
# disable Compile/Validate entirely (device editing and the file manager still work either way).
ESPHOME_DASHBOARD_URL=

# Credentials for the ESPHome dashboard - required if it's the split deploy's remote one
# (docker-compose-esphome.yml mandates auth, since its dashboard is published on the network).
# Leave both blank to disable.
ESPHOME_DASHBOARD_USERNAME=
ESPHOME_DASHBOARD_PASSWORD=

# MQTT broker for auto-discovery (Tasmota, Zigbee2MQTT, ESPHome's own native mqtt component, ...
# - anything speaking Home Assistant's own MQTT discovery convention). Not bundled in this file -
# run docker-compose-zigbee2mqtt.yml alongside it (which bundles its own broker), or point this at
# your own already-running one. Leave blank to disable MQTT auto-discovery entirely.
MQTT_BROKER_URL=

# Credentials for the MQTT broker - only needed if it requires auth.
MQTT_USERNAME=
MQTT_PASSWORD=

# Topic prefix discovery configs are published under - "homeassistant" is what every common
# publisher defaults to and rarely changes, but is itself configurable on all of them, so it's
# configurable here too.
MQTT_DISCOVERY_PREFIX=homeassistant

# "Forgot password" on the login page - this self-hosted instance has no SMTP of its own, so it
# asks the Athena website to relay the actual email instead. Works out of the box - defaults to
# the real domos.fi relay and this install registers its own credential with it automatically the
# first time it's needed, nothing to set here. Leave blank to disable "Forgot password" entirely -
# the link still shows, but tells the user to ask their administrator instead of a false promise.
PASSWORD_RESET_RELAY_URL=

# Also disables "Forgot password" entirely, independent of the URL above - a fallback opt-out for
# anywhere a blank URL alone isn't enough to tell "left blank on purpose" apart from "never set at
# all". Redundant with an explicitly blank URL set through the Environment page's own Password
# Reset card, which does work either way.
PASSWORD_RESET_DISABLED=

# Days of entity state-change history (Chart cards, the device-detail Activity feed) to keep
# before it's pruned - 0 means never delete. Defaults to 730 (~2 years) if left blank. Also
# editable live from the Environment page's own History retention card, no restart needed either
# way.
HISTORY_RETENTION_DAYS=

# Absolute host path of the folder containing this .env file and docker-compose-athena.yml -
# enables the "System info" page's own "Update" button, which shells out to `docker compose pull
# && docker compose up -d` for the whole stack. Leave blank (the default) to keep that button
# hidden - it needs two extra bind mounts (the host's own Docker socket, plus this same directory
# at the exact same absolute path inside the container) that are commented out by default in
# docker-compose-athena.yml. Uncomment both of those lines and set this to the folder's real
# absolute path (e.g. /opt/athena, not a relative path) before this does anything - see that
# file's own comment on those two mounts for why the path has to match exactly. "Restart" (the
# other button on that card) needs none of this.
ATHENA_DEPLOY_DIR=

# AI Assistant - three fully independent OpenAI-compatible servers (Chat, Speech-to-text,
# Text-to-speech), each its own base URL/model/optional API key. Leave a role's URL blank to
# disable just that role (e.g. chat-only with no voice). *_URL is the server's own OpenAI-compatible
# base URL - Athena appends /v1/chat/completions, /v1/models, /v1/audio/transcriptions, or
# /v1/audio/speech itself, the same way a real OpenAI SDK's base_url works. All of this is also
# editable live from the Environment page's own AI Assistant card, no restart needed either way.
ASSISTANT_CHAT_URL=
ASSISTANT_CHAT_MODEL=
ASSISTANT_CHAT_API_KEY=
ASSISTANT_STT_URL=
ASSISTANT_STT_MODEL=
# ISO 639-1 code (e.g. fi) - only takes effect against a multilingual model. Leave blank for
# auto-detect/whatever the server defaults to.
ASSISTANT_STT_LANGUAGE=
ASSISTANT_STT_API_KEY=
ASSISTANT_TTS_URL=
ASSISTANT_TTS_VOICE=
ASSISTANT_TTS_API_KEY=

# Default system prompt/persona for the AI Assistant, used wherever an Area has no system prompt
# of its own. Leave blank for no special instructions beyond Athena's own built-in tool-use framing.
ASSISTANT_SYSTEM_PROMPT=
