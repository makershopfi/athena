# Copy to .env in this same folder, then:
#   docker compose -f docker-compose-zigbee2mqtt.yml up -d
# (a separate .env from docker-compose-athena.yml's own, if you run both in this same folder -
# pass --env-file explicitly, e.g. `docker compose -f docker-compose-zigbee2mqtt.yml --env-file
# .env.zigbee2mqtt up -d`, otherwise.)

# Absolute path to your Zigbee coordinator's own stable device symlink - `ls /dev/serial/by-id/`
# to find it. Don't use /dev/ttyACM0/ttyUSB0 directly - that plain enumeration-order path can
# shift across reboots if more than one USB-serial adapter is plugged into the host.
ZIGBEE2MQTT_STICK_DEVICE=/dev/serial/by-id/usb-Silicon_Labs_...-if00-port0

# Zigbee2MQTT's own web frontend - device pairing, network map.
ZIGBEE2MQTT_PORT=8080

# Container timezone - only affects log timestamps.
TZ=Europe/Helsinki
