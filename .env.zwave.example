# Copy to .env in this same folder, then:
#   docker compose -f docker-compose-zwave.yml up -d
# (a separate .env from docker-compose-athena.yml's own, if you run both in this same folder -
# rename this to .env only when running zwave-js-ui on its own, e.g. `docker compose -f
# docker-compose-zwave.yml --env-file .env.zwave up -d` otherwise.)

# Absolute path to your Z-Wave stick's own stable device symlink - `ls /dev/serial/by-id/` to find
# it. Don't use /dev/ttyUSB0 or /dev/ttyACM0 directly - that plain enumeration-order path can shift
# across reboots if more than one USB-serial adapter is plugged into the host, and by-id is what
# docker-compose-zwave.yml's own hot-plug option (see its comments) also depends on.
ZWAVE_STICK_DEVICE=/dev/serial/by-id/usb-Silicon_Labs_CP2102_...-if00-port0

# Z-Wave JS UI's own web UI - pairing wizard, network map. Only needs to be reachable from
# whichever browser you pair devices from, not from Athena.
ZWAVE_UI_PORT=8091

# The actual zwave-js-server WebSocket - this is the port Athena's own "Add gateway" form needs.
ZWAVE_WS_PORT=3000
